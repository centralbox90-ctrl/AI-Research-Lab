[Unit]
Description=AI Research Lab private HTTP API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ai-research-lab
Group=ai-research-lab
WorkingDirectory=/opt/ai-research-lab/current
EnvironmentFile=/etc/ai-research-lab/ai-research-lab.env
ExecStart=/opt/ai-research-lab/venv/bin/python -m src.api.production_server --database /var/lib/ai-research-lab/research.db --host 127.0.0.1 --port 8080 --threads 4 --log-level INFO
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-research-lab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
